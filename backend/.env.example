APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Base URL do frontend headless (BFF Nuxt). Usada para montar links de
# email, ex. o link de reset de senha (/reset-password?token=...&email=...).
FRONTEND_URL=http://localhost:3000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Domínios stateful do Sanctum (SPA/BFF). Sobrescreve o padrão de config/sanctum.php.
# SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Monitoramento SERPRO (Integra Contador). Defaults fail-closed:
# homologação + dry-run + transporte desligado.
MONITORING_SERPRO_ENVIRONMENT=homologacao
MONITORING_SERPRO_DRY_RUN=true
MONITORING_SERPRO_BASE_URL=https://homologacao.serpro.gov.br/integra-contador/v1
MONITORING_SERPRO_TOKEN_URL=https://homologacao.serpro.gov.br/oauth/token
MONITORING_SERPRO_TRANSPORT_APPROVED=false
MONITORING_SERPRO_CONNECT_TIMEOUT=5
MONITORING_SERPRO_REQUEST_TIMEOUT=30
MONITORING_SERPRO_ROLE_TYPE=terceiro
MONITORING_SERPRO_QUEUE=serpro
MONITORING_SERPRO_MAX_ATTEMPTS=5
MONITORING_SERPRO_BACKOFF_BASE=60

# Fila dedicada do monitoramento (conexão `serpro`, driver database).
SERPRO_QUEUE=serpro
SERPRO_QUEUE_RETRY_AFTER=300
