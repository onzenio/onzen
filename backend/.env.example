APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000

# Base URL do frontend headless (BFF Nuxt). Usada para montar links de
# email, ex. o link de reset de senha (/reset-password?token=...&email=...).
FRONTEND_URL=http://localhost:3000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# Expiração dos tokens Sanctum em minutos (sessões first-party não expiram).
SANCTUM_TOKEN_EXPIRATION=43200

# Domínios stateful do Sanctum (SPA/BFF). Sobrescreve o padrão de config/sanctum.php.
# SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Integra Contador (fail-closed defaults: homologacao, dry-run, transporte desligado)
# Opere a fila dedicada: php artisan queue:work serpro --tries=8 --timeout=270
# O painel da Account A pode ligar o transporte em runtime (vence estas chaves);
# produção exige dupla confirmação e evidência. Estado efetivo: GET /api/monitoring/health.
MONITORING_SERPRO_BASE_URL=https://gateway.apiserpro.serpro.gov.br/integra-contador/v1
MONITORING_SERPRO_TOKEN_URL=https://autenticacao.sapi.serpro.gov.br/authenticate
MONITORING_SERPRO_ENVIRONMENT=homologacao
MONITORING_SERPRO_DRY_RUN=true
MONITORING_SERPRO_TRANSPORT_APPROVED=false
MONITORING_SERPRO_TIMEOUT=15
MONITORING_SERPRO_CONNECT_TIMEOUT=5
MONITORING_SERPRO_ROLE_TYPE=TERCEIROS
MONITORING_SERPRO_QUEUE=serpro
MONITORING_SERPRO_QUEUE_CONNECTION=serpro
MONITORING_SERPRO_FIXTURES_PATH=resources/fixtures/serpro/consultar
MONITORING_SERPRO_MAX_ATTEMPTS=8
MONITORING_SERPRO_CREDENTIAL_VERSION=1
