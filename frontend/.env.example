# Public URL, used for OG Image when running nuxt generate
NUXT_PUBLIC_SITE_URL=

# Laravel API base URL usada pelas server routes do BFF (canônico).
# Tem precedência sobre NUXT_BACKEND_URL.
BACKEND_URL=http://localhost:8000

# BFF session seal secret (32+ bytes hex). Generate with: openssl rand -hex 32
SESSION_SECRET=

# Fallback legado da base do backend (ex.: http://backend:8000 no compose).
# Prefira BACKEND_URL; mantido apenas para compatibilidade.
NUXT_BACKEND_URL=http://localhost:8000
