# Public URL, used for OG Image when running nuxt generate
NUXT_PUBLIC_SITE_URL=

# Laravel API base URL used by the BFF server routes
BACKEND_URL=http://localhost:8000

# BFF session seal secret (32+ bytes hex). Generate with: openssl rand -hex 32
SESSION_SECRET=

# Base do backend Laravel usada pelo BFF (/api/monitoring/*). No compose: http://backend:8000
NUXT_BACKEND_URL=http://localhost:8000
